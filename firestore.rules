rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validations
    function isValidForumCategory(data) {
      return data.keys().hasAll(['title', 'slug']) &&
             data.keys().size() <= 3 &&
             data.title is string && data.title.size() <= 100 &&
             data.slug is string && data.slug.matches('^[a-z0-9-]+$');
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'categoryId', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidForumComment(data) {
      return data.keys().hasAll(['content', 'authorId', 'postId', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.content is string && data.content.size() <= 1000 &&
             data.authorId == request.auth.uid &&
             data.postId is string &&
             data.createdAt == request.time;
    }

    function isValidRoomMessage(data) {
      return data.keys().hasAll(['text', 'senderId', 'senderName', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidRoomParticipant(data) {
      return data.keys().hasAll(['participantId', 'userName', 'lastSeen']) &&
             data.keys().size() <= 6 &&
             data.participantId is string && data.participantId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.lastSeen == request.time;
    }

    function isValidSessionRecording(data) {
      return data.keys().hasAll(['title', 'roomId', 'type', 'recordedById', 'recordedByName', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.title is string && data.title.size() <= 200 &&
             data.roomId is string && data.roomId.size() <= 128 &&
             (data.type == 'screen' || data.type == 'audio') &&
             data.recordedById is string && data.recordedById.size() <= 128 &&
             data.recordedByName is string && data.recordedByName.size() <= 100 &&
             data.createdAt == request.time;
    }

    // Collections
    match /forumCategories/{categoryId} {
      allow read: if true;
      allow write: if false; // Only admin can create categories (manual for now)
    }

    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidForumPost(incoming());
      allow update: if isOwner(existing().authorId) && 
                      isValidForumPost(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']) &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().authorId);
    }

    match /forumComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidForumComment(incoming());
      allow update: if isOwner(existing().authorId) && 
                      isValidForumComment(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['content']) &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().authorId);
    }

    match /studySessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    match /rooms/{roomId} {
      // Allow reading room info to verify PIN and public/private status
      allow read: if true;
      // Allow creating and updating room security and PIN configuration
      allow create, update: if true;

      // Real-time chat messages
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidRoomMessage(incoming());
        allow update, delete: if isOwner(existing().senderId);
      }

      // Real-time room participants
      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isValidRoomParticipant(incoming());
        allow delete: if true;
      }

      // Session recordings
      match /recordings/{recordingId} {
        allow read: if true;
        allow create: if isValidSessionRecording(incoming());
        allow update, delete: if isOwner(existing().recordedById) || !isSignedIn();
      }
    }
  }
}
