rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validations
    function isValidForumCategory(data) {
      return data.keys().hasAll(['title', 'slug']) &&
             data.keys().size() <= 3 &&
             data.title is string && data.title.size() <= 100 &&
             data.slug is string && data.slug.matches('^[a-z0-9-]+$');
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'categoryId', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidForumComment(data) {
      return data.keys().hasAll(['content', 'authorId', 'postId', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.content is string && data.content.size() <= 1000 &&
             data.authorId == request.auth.uid &&
             data.postId is string &&
             data.createdAt == request.time;
    }

    // Collections
    match /forumCategories/{categoryId} {
      allow read: if true;
      allow write: if false; // Only admin can create categories (manual for now)
    }

    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidForumPost(incoming());
      allow update: if isOwner(existing().authorId) && 
                      isValidForumPost(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']) &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().authorId);
    }

    match /forumComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidForumComment(incoming());
      allow update: if isOwner(existing().authorId) && 
                      isValidForumComment(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['content']) &&
                      incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().authorId);
    }

    match /studySessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    match /rooms/{roomId} {
      // Allow reading room info to verify PIN and public/private status
      allow read: if true;
      // Allow creating and updating room security and PIN configuration
      allow create, update: if true;
    }
  }
}
