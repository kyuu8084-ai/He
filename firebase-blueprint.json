{
  "entities": {
    "ForumCategory": {
      "title": "Forum Category",
      "description": "A category within the forum",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "required": ["title", "slug"]
    },
    "ForumPost": {
      "title": "Forum Post",
      "description": "A post in the forum",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "categoryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId", "categoryId", "createdAt"]
    },
    "ForumComment": {
      "title": "Forum Comment",
      "description": "A comment on a forum post",
      "type": "object",
      "properties": {
        "content": { "type": "string", "maxLength": 1000 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "postId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "postId", "createdAt"]
    },
    "StudySession": {
      "title": "Study Session",
      "description": "A recorded study session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "categoryId": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "durationSeconds", "startTime", "endTime"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "A user's profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "interests": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "photoURL": { "type": "string" },
        "headerURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "createdAt"]
    },
    "StudyRoom": {
      "title": "Study Room",
      "description": "Metadata and security configuration (PIN) for collaborative study rooms",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "pin": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "isPrivate"]
    }
  },
  "firestore": {
    "forumCategories": {
      "schema": "ForumCategory",
      "description": "Global categories for the forum"
    },
    "forumPosts": {
      "schema": "ForumPost",
      "description": "Forum posts"
    },
    "forumComments": {
      "schema": "ForumComment",
      "description": "Comments on forum posts"
    },
    "studySessions": {
      "schema": "StudySession",
      "description": "User study sessions"
    },
    "users": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "rooms": {
      "schema": "StudyRoom",
      "description": "Study rooms metadata, security PINs, and privacy status"
    }
  }
}
